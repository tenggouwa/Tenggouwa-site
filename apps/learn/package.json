{
  "name": "@tenggouwa/learn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-textbook.mjs && tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm build && playwright test && pnpm test:labs",
    "lint": "node scripts/build-textbook.mjs --check && tsc --noEmit",
    "test:labs": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "textbook": "node scripts/build-textbook.mjs",
    "predev": "pnpm textbook"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "5.9.3",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "2.0.3"
  }
}
